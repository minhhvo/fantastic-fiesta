{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "inputs": [
        {
            "id": "packageName",
            "type":"promptString",
            "description": "Enter the package to focus on:",
        },
        {
            "id": "exeTarget",
            "type": "promptString",
            "description": "Path to test-build executable (e.g., build/algebra_test.exe):"
        },
    ],
    "tasks": [
        {
            "label": "Focus Package",
            "type": "shell",
            "command": "./scripts/focus.sh ${input:packageName}",
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "Create New Package",
            "type": "shell",
            "command": "uv init --lib packages/${input:packageName}",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}