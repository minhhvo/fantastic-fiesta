{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "inputs": [
        {
            "id": "packageName",
            "type":"promptString",
            "description": "Enter the package to focus on:",
        }
    ],
    "tasks": [
        {
            "label": "Focus Package",
            "type": "shell",
            "command": "./scripts/focus.sh ${input:packageName}",
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "Create New Package",
            "type": "shell",
            "command": "uv init --lib packages/${input:packageName}",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "type": "cmake",
            "label": "CMake: configure",
            "command": "configure",
            "problemMatcher": [],
            "detail": "CMake template configure task",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}