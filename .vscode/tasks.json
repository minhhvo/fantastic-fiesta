{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "inputs": [
        {
            "id": "packageName",
            "type":"promptString",
            "description": "Enter the package to focus on:",
            "default": "bibtex_frbr"
        }
    ],
    "tasks": [
        {
            "label": "Focus Package",
            "type": "shell",
            "command": "./scripts/focus.sh ${input:packageName}",
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent"
            }
        }
    ]
}